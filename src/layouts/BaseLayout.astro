---
import { ClientRouter } from 'astro:transitions';
import { siteConfig } from '../config';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/style.scss';

interface Props {
  title?: string;
  description?: string;
  /** Path of a social-preview image; defaults to the avatar. */
  image?: string;
  /** "sidebar": profile card + content column (home, blog index). "wide": full-width article (posts). */
  variant?: 'sidebar' | 'wide';
  /** Wide pages only: reserve a side rail for a table of contents on large screens. */
  hasToc?: boolean;
}

const { title = siteConfig.title, description = siteConfig.description, image, variant = 'sidebar', hasToc = false } = Astro.props;
const fontMode = siteConfig.font === 'Serif' ? 'serif' : 'sans';
const pageTitle = title === siteConfig.title ? `${siteConfig.title} | ${siteConfig.affiliation}` : `${title} | ${siteConfig.title}`;
const ogImage = Astro.site ? new URL(image ?? siteConfig.avatar, Astro.site).href : (image ?? siteConfig.avatar);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const isArticle = variant === 'wide';
---

<!DOCTYPE html>
<html lang="en" data-font={fontMode} data-theme={siteConfig.autoDarkMode ? undefined : 'light'}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{pageTitle}</title>

    <meta name="description" content={description}>
    <meta name="keywords" content={siteConfig.keywords}>
    <meta name="author" content={siteConfig.title}>
    <meta name="theme-color" content="#f5f7fb" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0a0e17" media="(prefers-color-scheme: dark)">
    <meta property="og:type" content={isArticle ? 'article' : 'website'}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta name="twitter:card" content="summary_large_image">
    {canonical && <link rel="canonical" href={canonical}>}
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} — Blog`} href="/rss.xml">
    <slot name="head" />

    <!-- Client-side navigation with view transitions; the background canvas persists across pages. -->
    <ClientRouter />

    <!-- Apply the stored theme before first paint (avoids a flash), and flag JS availability
         so scroll-reveal styles only apply when the scripts will actually run. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') d.setAttribute('data-theme', t);
        } catch (e) {}
        // Safety net: if the UI script never runs, show everything after a moment.
        setTimeout(function () {
          if (!d.classList.contains('ui-ready')) d.classList.add('reveal-all');
        }, 2500);
      })();
    </script>

    <!-- Favicons -->
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" media="(prefers-color-scheme:dark)" href={`${siteConfig.faviconDark}?v=2`} type="image/png" />
    <link rel="icon" media="(prefers-color-scheme:light)" href={`${siteConfig.favicon}?v=2`} type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />

    <!-- Academic Icons & Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/academicons/1.8.6/css/academicons.min.css" integrity="sha256-uFVgMKfistnJAfoCUQigIl+JfUaP47GrRKjf6CTPVmw=" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">

    <script is:inline src="/assets/js/favicon-switcher.js"></script>
  </head>
  <body>
    <div class="bg-blobs" aria-hidden="true" transition:persist="blobs"><span></span><span></span><span></span></div>
    <canvas id="bg-canvas" aria-hidden="true" transition:persist="canvas"></canvas>

    <SiteHeader variant={variant} />

    {variant === 'sidebar' ? (
      <div class="wrapper">
        <aside class="sidebar">
          <div class="profile" data-tilt="2">
            {siteConfig.avatar && (
              <div class="avatar-wrap">
                <img src={siteConfig.avatar} alt={siteConfig.title} width="148" height="148" />
              </div>
            )}

            <div class="profile-main">
              <h1 class="name"><span>{siteConfig.title}</span></h1>
              {siteConfig.position && <p class="role">{siteConfig.position}</p>}
              {siteConfig.affiliation && <p class="affiliation">{siteConfig.affiliation}</p>}
              {siteConfig.email && <span class="email">{siteConfig.email}</span>}

              <div class="social">
                {siteConfig.googleScholar && (
                  <a href={siteConfig.googleScholar} target="_blank" rel="noopener" title="Google Scholar" aria-label="Google Scholar">
                    <i class="ai ai-google-scholar" aria-hidden="true"></i>
                  </a>
                )}
                {siteConfig.cvLink && (
                  <a href={siteConfig.cvLink} target="_blank" rel="noopener" title="Curriculum Vitae" aria-label="Curriculum Vitae">
                    <i class="ai ai-cv" aria-hidden="true"></i>
                  </a>
                )}
                {siteConfig.githubLink && (
                  <a href={siteConfig.githubLink} target="_blank" rel="noopener" title="GitHub" aria-label="GitHub">
                    <i class="fab fa-github" aria-hidden="true"></i>
                  </a>
                )}
                {siteConfig.linkedin && (
                  <a href={siteConfig.linkedin} target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn">
                    <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                  </a>
                )}
                {siteConfig.twitter && (
                  <a href={siteConfig.twitter} target="_blank" rel="noopener" title="X / Twitter" aria-label="X / Twitter">
                    <i class="fab fa-x-twitter" aria-hidden="true"></i>
                  </a>
                )}
              </div>
            </div>
          </div>
        </aside>

        <main class="content">
          <slot />
          <SiteFooter />
        </main>
      </div>
    ) : (
      <main class:list={['wide-page', { 'has-toc': hasToc }]}>
        <slot />
        <SiteFooter />
      </main>
    )}

    <button type="button" class="to-top" data-to-top aria-label="Back to top">
      <i class="fas fa-arrow-up" aria-hidden="true"></i>
    </button>

    <script>
      import '../scripts/ui';
      import '../scripts/background';
    </script>

    {siteConfig.googleAnalytics && (
      <script is:inline define:vars={{ gaId: siteConfig.googleAnalytics }}>
        (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
        (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
        m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
        })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');
        ga('create', gaId, 'auto');
        ga('send', 'pageview');
      </script>
    )}
  </body>
</html>
