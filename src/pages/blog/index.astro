---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getPosts, getPostBody, readingTime, formatDate } from '../../utils/posts';

const sorted = getPosts();
---

<BaseLayout title="Blog" description="Longer write-ups of papers and ideas by Arber Zela, with the figures and animations that did not fit in the PDF.">
  <section class="block" id="blog">
    <SectionHead index="06" title="Blog" />
    <div class="blog-intro" data-reveal>
      <p class="lead">Longer write-ups of papers and ideas, with the figures and animations that did not fit in the PDF.</p>
      <a class="pill" href="/rss.xml" title="RSS feed"><i class="fas fa-rss" aria-hidden="true"></i>RSS</a>
    </div>
    <ul class="post-list">
      {sorted.map((post, i) => (
        <li class="post-card" data-reveal data-tilt="3" style={`--i:${i + 1}`}>
          <a class="cover" href={`/blog/${post.slug}/`} tabindex="-1" aria-hidden="true">
            <img src={post.cover} alt="" loading="lazy" decoding="async" />
          </a>
          <div class="body">
            <div class="meta">
              <time datetime={post.date}>{formatDate(post.date)}</time>
              <span aria-hidden="true">·</span>
              <span>{readingTime(getPostBody(post.slug))} min read</span>
            </div>
            <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
            <p class="subtitle">{post.subtitle}</p>
            <p class="summary">{post.summary}</p>
            <div class="tags">{post.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
            <div class="more">
              <a class="pill" href={`/blog/${post.slug}/`}><i class="fas fa-arrow-right" aria-hidden="true"></i>Read the post</a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
