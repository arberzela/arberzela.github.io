---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';
import body from '../../content/blog/sfprm/body.html?raw';

const post = posts.find((p) => p.slug === 'sfprm')!;
---

<BaseLayout variant="wide" title={post.title} description={post.summary} image={post.cover}>
  <article class="post">
    <Fragment set:html={body} />
  </article>
</BaseLayout>
