---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import Publications from '../components/Publications.astro';

const interests = [
  { title: 'Adaptive Computation', text: 'Reasoning, looping, test-time training' },
  { title: 'Global Optimization', text: 'Hyperparameter optimization, multi-objective optimization, architecture search' },
  { title: 'Artificial Life', text: 'Cellular automata, evolutionary computation' },
];

// Newest first. `text` is rendered as HTML, so inline links/emphasis are allowed.
const news = [
  { date: 'Sep 2026', text: '"TempoPFN: Synthetic Pre-training of Linear RNNs for Zero-shot Time Series Forecasting" is accepted at NeurIPS 2026.' },
  { date: 'Jun 2026', text: '"Evolving Many Worlds: Towards Open-Ended Discovery in Petri Dish NCA via Population-Based Training" was accepted for Oral presentation at ALife 2026.' },
  { date: 'May 2026', text: "I joined Volkan Cevher's LIONS lab at EPFL as a postdoc." },
  { date: 'Jan 2026', text: '"Improving LLM-based Global Optimization with Search Space Partitioning" is accepted at ICLR 2026.' },
  { date: 'Nov 2025', text: '"TempoPFN: Towards Synthetic Pre-training of Linear RNNs for Zero-shot Time Series Forecasting" is accepted at AITD@EurIPS 2025.' },
  { date: 'Oct 2025', text: 'I successfully defended my PhD Thesis with summa cum laude.' },
  { date: 'Sep 2025', text: '"DeltaProduct: Improving State-Tracking in Linear RNNs via Householder Products" is accepted at NeurIPS 2025.' },
  { date: 'May 2025', text: '"Regularized Neural Ensemblers" is accepted at AutoML Conference 2025.' },
  { date: 'Mar 2025', text: '"DeltaProduct: Increasing the Expressivity of DeltaNet Through Products of Householders" is accepted at FM-WILD Workshop at ICLR 2025 as an Oral.' },
  { date: 'Feb 2025', text: '2 papers accepted at ICLR 2025. "Multi-objective Differentiable Neural Architecture Search" as a Poster and "Unlocking State-Tracking in Linear RNNs Through Negative Eigenvalues" as an Oral.' },
  { date: 'Oct 2024', text: '3 papers accepted at NeurIPS 2024 workshops: "Unlocking State-Tracking in Linear RNNs Through Negative Eigenvalues" (Oral), "GAMformer" (Poster), and "Ensembling Finetuned Language Models for Text Classification" (Poster).' },
  { date: 'Sep 2024', text: '"HW-GPT-Bench: Hardware-Aware Architecture Benchmark for Language Models" was accepted to NeurIPS 2024 Datasets and Benchmarks Track.' },
  { date: 'Jun 2024', text: '"Multi-objective Differentiable Neural Architecture Search" was accepted to the WANT workshop at ICML 2024.' },
];

---

<BaseLayout>
  <section class="block" id="about">
    <SectionHead index="01" title="About Me" />
    <p class="lead" data-reveal>
      I am a Postdoctoral Researcher at <strong>LIONS, EPFL</strong>. Before I was an ELLIS Ph.D. student at the
      <strong>University of Freiburg</strong> advised by Frank Hutter and co-advised by Yee Whye Teh at the
      <strong>University of Oxford</strong>. Since 2025 I am also an ELLIS member.
    </p>
  </section>

  <section class="block" id="interests">
    <SectionHead index="02" title="Research Interests" />
    <ul class="interests">
      {interests.map((item, i) => (
        <li class="interest" data-reveal data-tilt="6" style={`--i:${i}`}>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" id="news">
    <SectionHead index="03" title="News" />
    <ol class="timeline" data-collapsible="6" data-reveal>
      {news.map((item, i) => (
        <li data-reveal style={`--i:${Math.min(i, 5)}`}>
          <span class="date">{item.date}</span>
          <span class="what" set:html={item.text}></span>
        </li>
      ))}
    </ol>
  </section>


  <Publications />
</BaseLayout>
