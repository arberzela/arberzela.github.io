---
// Light/dark switch. CSS shows the moon or the sun depending on the active theme;
// src/scripts/ui.ts stores the choice in localStorage.
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle colour theme" title="Toggle colour theme">
  <i class="fas fa-moon" aria-hidden="true"></i>
  <i class="fas fa-sun" aria-hidden="true"></i>
</button>
