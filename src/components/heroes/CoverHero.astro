---
// Fallback hero for posts without a custom illustration: the cover figure on the dark grid.
import type { Post } from '../../data/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
---

<section class="post-hero cover-hero" aria-label={post.title}>
  <img class="cover-figure" src={post.cover} alt="" />
  {post.code && (
    <a class="hero-github-badge" href={post.code} target="_blank" rel="noopener" title="View the code on GitHub">
      <i class="fab fa-github" aria-hidden="true"></i><span>GitHub</span>
    </a>
  )}
  <div class="hero-overlay">
    <div class="hero-nav">
      <div class="hero-info">
        <p class="hero-title">{post.title.toUpperCase()}</p>
        <p class="hero-desc">{post.subtitle}</p>
      </div>
    </div>
    {post.paper && (
      <div class="hero-controls is-single">
        <a class="control-btn explore-cta-btn" href={post.paper} target="_blank" rel="noopener">Paper ➜</a>
      </div>
    )}
  </div>
</section>
