---
// Full-width interactive hero for the SFPRM post: tokens running the spherical fixed-point loop
// on a draggable sphere, with a glass control card (scenes, λ and η settings, a halting-residual
// chart, pause, re-run, speed).
import { SFPRM_SCENES, LAMBDA_OPTIONS, ETA_OPTIONS, heroCaps, lambdaLabel, etaLabel, etaValue } from '../../scripts/heroes/sfprm-scenes';

interface Props {
  paper?: string;
  code?: string;
}
const { paper, code } = Astro.props;
const first = SFPRM_SCENES[0];
---

<section class="post-hero" data-sphere-hero aria-label="Interactive illustration of the spherical fixed-point loop">
  <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>

  <div class="hero-legend" aria-hidden="true">
    <span class="legend-item"><span class="legend-dot is-ring" style="--c: #fb923c"></span>Input x</span>
    <span class="legend-item"><span class="legend-dot" style="--c: #38bdf8"></span>Proposal z̃</span>
    <span class="legend-item"><span class="legend-dot" style="--c: #a78bfa"></span>State z</span>
    <span class="legend-item"><span class="legend-dot is-ring is-dashed is-cap" style="--c: #94a3b8"></span>Halting cap 8.1°</span>
    <span class="legend-item"><span class="legend-dot" style="--c: #34d399"></span>Halted</span>
    <span class="legend-item" data-legend-answer hidden><span class="legend-dot is-ring is-dashed" style="--c: #34d399"></span>Answer at λ = 0.3</span>
  </div>

  {code && (
    <a class="hero-github-badge" href={code} target="_blank" rel="noopener" title="View the code on GitHub">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
      </svg>
      <span>GitHub</span>
    </a>
  )}

  <div class="hero-tooltip" data-hero-tooltip hidden>
    <span class="tip-title" data-tip-title></span>
    <span class="tip-row">∠ to proposal <b data-tip-value></b></span>
    <span class="tip-state" data-tip-state></span>
  </div>

  <p class="hero-hint" aria-hidden="true">Toy dynamics on S² · drag to rotate · hover a state</p>

  <div class="hero-overlay">
    <div class="hero-nav">
      <button type="button" class="nav-btn" data-hero-prev aria-label="Previous scene">&larr;</button>
      <div class="hero-info">
        <p class="hero-title" data-hero-title>{heroCaps(first.title)}</p>
        <p class="hero-desc" data-hero-desc>{first.desc}</p>
        <canvas class="hero-chart" data-hero-chart aria-hidden="true"></canvas>
        <p class="hero-status" data-hero-status aria-live="off"></p>
      </div>
      <div class="nav-next-wrapper">
        <button type="button" class="nav-btn" data-hero-next aria-label="Next scene">&rarr;</button>
        <div class="hero-counter" data-hero-counter>1 / {SFPRM_SCENES.length}</div>
      </div>
    </div>
    <div class="hero-controls">
      <select class="control-btn control-select" data-hero-lambda aria-label="Injection strength λ">
        {LAMBDA_OPTIONS.map((l) => <option value={String(l)} selected={l === first.lambda}>{lambdaLabel(l)}</option>)}
      </select>
      <select class="control-btn control-select" data-hero-eta aria-label="Step size η">
        {ETA_OPTIONS.map((e) => <option value={etaValue(e)} selected={e === first.eta}>{etaLabel(e)}</option>)}
      </select>
      <button type="button" class="control-btn" data-hero-play>Pause</button>
      <button type="button" class="control-btn" data-hero-rerun>Re-run</button>
      <button type="button" class="control-btn" data-hero-speed>Speed 1×</button>
      {paper
        ? <a class="control-btn explore-cta-btn" href={paper} target="_blank" rel="noopener">Paper ➜</a>
        : <a class="control-btn explore-cta-btn" href="#method">Method ↓</a>}
    </div>
  </div>
</section>

<script>
  import '../../scripts/heroes/sfprm-hero';
</script>
