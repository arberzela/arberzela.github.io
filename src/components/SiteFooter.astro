---
import { siteConfig } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <span>© {year} {siteConfig.title}</span>
  {siteConfig.enableFootnote && (
    <span>
      Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>, inspired by
      <a href="https://github.com/yaoyao-liu/minimal-light" target="_blank" rel="noopener">Minimal Light</a>.
    </span>
  )}
</footer>
